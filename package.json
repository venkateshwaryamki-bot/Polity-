{
  "name": "civix",
  "version": "1.0.0",
  "private": true,
  "description": "Civix: Indian Polity for UPSC Prelims and Mains. Web app and Android app (Capacitor).",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "assets": "npx capacitor-assets generate --android --assetPath resources",
    "sync": "npx cap sync android",
    "android": "npx cap open android",
    "apk": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "aab": "npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
